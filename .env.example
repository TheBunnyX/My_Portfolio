ADMIN_USERNAME=Admin
# Use a long, unique password. Never commit your real .env file.
ADMIN_PASSWORD=replace-with-a-long-unique-password
# Set to true behind HTTPS in production.
COOKIE_SECURE=false
# Development website port and internal authentication API port.
PORT=5173
AUTH_PORT=8787
# Persistent server-side content file. Back this file up in production.
CONTENT_DATA_FILE=data/content.json

# --- Vercel only (set these in Project Settings > Environment Variables, not here) ---
# ADMIN_USERNAME and ADMIN_PASSWORD are required there too.
# BLOB_READ_WRITE_TOKEN is added automatically when a Vercel Blob store is connected.
# BLOB_ACCESS=private        # set to "public" if the Blob store was created as public
# SITE_URL=https://your-domain.com   # canonical URL for SEO; defaults to the Vercel production domain
# SESSION_SECRET=            # optional; defaults to a key derived from the admin credentials
